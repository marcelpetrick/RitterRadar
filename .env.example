# RitterRadar — example environment configuration
# Copy to .env and adjust values before running.

# Path to sources YAML file (default: config/sources.yaml)
RITTERRADAR_SOURCES_FILE=config/sources.yaml

# SQLite database path (default: data/ritterradar.db)
RITTERRADAR_DB_PATH=data/ritterradar.db

# Number of parallel crawler workers (default: 3)
RITTERRADAR_WORKERS=3

# Nominatim contact e-mail. Set a real contact when using geocoding.
RITTERRADAR_GEOCODER_EMAIL=your@email.example

# Web server host (default: 127.0.0.1)
RITTERRADAR_HOST=127.0.0.1

# Web server port (default: 8000)
RITTERRADAR_PORT=8000

# Log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
RITTERRADAR_LOG_LEVEL=INFO

# Re-crawl interval in hours — sources are re-queued after this many hours (default: 24)
RITTERRADAR_CRAWL_INTERVAL_HOURS=24

# Local installs may leave the token unset. Any non-loopback client requires it.
# Compose requires a token. Generate and store one in your password manager.
# For native loopback use leave this unset (remove the comment marker to set it).
# RITTERRADAR_AUTH_TOKEN=

# JSON array. Add the exact Host name used by a reverse proxy, if applicable.
RITTERRADAR_ALLOWED_HOSTS=["127.0.0.1","localhost","::1"]

# Disable all outbound crawling/geocoding and third-party map tile requests.
RITTERRADAR_OFFLINE=false

# Request and crawler resource bounds
RITTERRADAR_REQUEST_LIMIT=120
RITTERRADAR_REQUEST_CONCURRENCY=16
RITTERRADAR_MAX_RESPONSE_BYTES=8000000
RITTERRADAR_MAX_CRAWL_RECORDS=10000
RITTERRADAR_CRAWL_TIMEOUT_SECONDS=900
RITTERRADAR_MAX_CRAWL_PAGES=50
RITTERRADAR_QUEUE_LIMIT=32
RITTERRADAR_CACHE_DAYS=30
